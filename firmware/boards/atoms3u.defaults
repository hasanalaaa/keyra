# M5Stack AtomS3U (USB-A stick, ESP32-S3FN8: 8 MB flash, no PSRAM).
# Sources: https://docs.m5stack.com/en/core/AtomS3U (pin map: IR G12, WS2812 DIN G35, button G41);
#   M5Unified (M5Stack's library) src/M5Unified.inl: board_M5AtomS3U reads
#   "!m5gfx::gpio_in(GPIO_NUM_41)" (active low) and its RGB LED pin is GPIO_NUM_35.
CONFIG_KEYRA_BOARD_ID="atoms3u"
CONFIG_KEYRA_BUTTON_GPIO=41
CONFIG_KEYRA_BUTTON_ACTIVE_LOW=y
CONFIG_KEYRA_LED_WS2812=y
CONFIG_KEYRA_LED_GPIO=35
# No PSRAM in the FN8, and GPIO35 (an octal PSRAM data line) is the LED here.
CONFIG_SPIRAM=n
