# Seeed Studio XIAO ESP32S3 (ESP32-S3R8: 8 MB octal PSRAM in the chip, 8 MB flash, USB-C on the native USB).
# Sources: https://wiki.seeedstudio.com/xiao_esp32s3_getting_started/ (user LED on GPIO21, "will only
#   turn off when the user LED pin ... is set to a high level", i.e. active low; Boot button GPIO0);
#   arduino-esp32 variants/XIAO_ESP32S3/pins_arduino.h: LED_BUILTIN = 21.
CONFIG_KEYRA_BOARD_ID="xiao-esp32s3"
CONFIG_KEYRA_BUTTON_GPIO=0
CONFIG_KEYRA_BUTTON_ACTIVE_LOW=y
CONFIG_KEYRA_LED_PLAIN=y
CONFIG_KEYRA_LED_GPIO=21
CONFIG_KEYRA_LED_ACTIVE_LOW=y
