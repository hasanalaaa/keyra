# Espressif ESP32-S3-DevKitC-1 v1.1 (the reference board; default build, update asset keyra-firmware.bin).
# Layered on sdkconfig.defaults + sdkconfig.release; these values are the defaults, spelled out.
# Source: https://docs.espressif.com/projects/esp-dev-kits/en/latest/esp32s3/esp32-s3-devkitc-1/user_guide_v1.1.html
#   "Addressable RGB LED, driven by GPIO38"; Boot button on the GPIO0 strapping pin.
CONFIG_KEYRA_BOARD_ID="devkitc1"
CONFIG_KEYRA_BUTTON_GPIO=0
CONFIG_KEYRA_BUTTON_ACTIVE_LOW=y
CONFIG_KEYRA_LED_WS2812=y
CONFIG_KEYRA_LED_GPIO=38
