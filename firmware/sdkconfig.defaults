# Keyra dev profile (SPEC §7). Release overrides live in sdkconfig.release.
CONFIG_IDF_TARGET="esp32s3"

# Flash: 8 MB baseline so one image runs on 8 MB and 16 MB boards.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# PSRAM: reference board N16R8 has 8 MB octal PSRAM; boards without it must still boot.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_SPIRAM_USE_MALLOC=y

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
# 1 ms ticks so HID key delays (default 12 ms) are not rounded to 10 ms steps.
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# HTTP: phones send long User-Agent/cookie headers.
CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048
# httpd needs max_open_sockets(7) + 3 internal, plus DNS and mDNS.
CONFIG_LWIP_MAX_SOCKETS=16

# USB (keyra_hid): one HID keyboard; CDC compiled in for the dev log/ROM-reboot port.
CONFIG_TINYUSB_HID_COUNT=1
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=1

# TinyUSB takes the USB pins at runtime, so the default secondary USB-Serial-JTAG
# console would go dead; keyra_hid mirrors logs to its dev CDC instead.
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_KEYRA_DEV_CDC=y
