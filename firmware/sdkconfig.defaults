# Keyra dev profile (SPEC §7). Release overrides live in sdkconfig.release.
CONFIG_IDF_TARGET="esp32s3"

# Flash: 8 MB baseline so one image runs on 8 MB and 16 MB boards.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# PSRAM: reference board N16R8 has 8 MB octal PSRAM; boards without it must still boot.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_SPIRAM_USE_MALLOC=y

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
# 1 ms ticks so HID key delays (default 12 ms) are not rounded to 10 ms steps.
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# HTTP: phones send long User-Agent/cookie headers.
CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048
# httpd needs max_open_sockets(7) + 3 internal, plus DNS and mDNS.
CONFIG_LWIP_MAX_SOCKETS=16
# SNTP (SPEC §8.2): pool.ntp.org and time.google.com.
CONFIG_LWIP_SNTP_MAX_SERVERS=2

# USB (keyra_hid): HID keyboard + FIDO security key (keyra_fido); CDC compiled in for the dev log/ROM-reboot port.
CONFIG_TINYUSB_HID_COUNT=2
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=1

# TinyUSB takes the USB pins at runtime, so the default secondary USB-Serial-JTAG
# console would go dead; keyra_hid mirrors logs to its dev CDC instead.
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_KEYRA_DEV_CDC=y

# Bluetooth LE keyboard (keyra_ble, SPEC §8.1): NimBLE only, BLE only.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED=y
# Peripheral for the keyboard. Central is compiled in only because NimBLE ties
# the GATT client to it (Keyra reads the host's device name); Keyra never
# scans or initiates connections.
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_GATT_CLIENT=y
# One host at a time; the controller needs one advertising + one link slot.
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_CTRL_BLE_MAX_ACT=2
# Bonds: 4 hosts (keyra::ble::kMaxBonds), persisted in NVS; 4 CCCDs each.
CONFIG_BT_NIMBLE_SECURITY_ENABLE=y
CONFIG_BT_NIMBLE_SM_SC=y
CONFIG_BT_NIMBLE_SM_LEGACY=n
# Not "SC Only mode": in NimBLE it demands MITM-authenticated pairing for every
# protected attribute, which a display-less Just Works device can never reach,
# so hosts could pair but never read the HID service. Legacy pairing stays
# compiled out above, so pairing is still LE Secure Connections only.
CONFIG_BT_NIMBLE_SM_SC_ONLY=0
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_MAX_BONDS=4
CONFIG_BT_NIMBLE_MAX_CCCDS=16
# Settings allow 32-byte device names.
CONFIG_BT_NIMBLE_GAP_DEVICE_NAME_MAX_LEN=32
CONFIG_BT_NIMBLE_SVC_GAP_DEVICE_NAME="Keyra"
# keyra_ble defines its own HID/DIS/BAS tables; drop the unused stock services.
CONFIG_BT_NIMBLE_HID_SERVICE=n
CONFIG_BT_NIMBLE_PROX_SERVICE=n
CONFIG_BT_NIMBLE_ANS_SERVICE=n
CONFIG_BT_NIMBLE_CTS_SERVICE=n
CONFIG_BT_NIMBLE_HTP_SERVICE=n
CONFIG_BT_NIMBLE_IPSS_SERVICE=n
CONFIG_BT_NIMBLE_TPS_SERVICE=n
CONFIG_BT_NIMBLE_IAS_SERVICE=n
CONFIG_BT_NIMBLE_LLS_SERVICE=n
CONFIG_BT_NIMBLE_SPS_SERVICE=n
CONFIG_BT_NIMBLE_HR_SERVICE=n
CONFIG_BT_NIMBLE_BAS_SERVICE=n
CONFIG_BT_NIMBLE_DIS_SERVICE=n
# Keep the host's heap in internal RAM: PSRAM is optional on Keyra boards.
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_INTERNAL=y
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y
# Wi-Fi SoftAP and BLE share the 2.4 GHz radio: software coexistence.
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y

# The API parses request bodies on the httpd task (12 KB stack). cJSON
# recurses about 64 bytes per nesting level, so its default limit of 1000 let
# ~200 '[' from anyone on the network overflow the stack. Real bodies (a
# restore with its backup inside) nest about 6 deep.
CONFIG_CJSON_NESTING_LIMIT=16
