menu "Keyra"

config KEYRA_DEV_CDC
    bool "Developer USB CDC (log mirror + 1200-baud reboot to ROM)"
    default y
    help
        Adds a CDC-ACM interface next to the HID keyboard so tools/devctl.py can
        read logs and reboot into download mode. Release builds disable it so the
        device enumerates as a plain keyboard.

config KEYRA_UPDATE_REPO
    string "GitHub repository that publishes updates (owner/name)"
    default "hasanalaaa/keyra"
    help
        "Check for updates" asks this repository's latest GitHub release for
        this board's image (KEYRA_BOARD_ID). Only images signed with the key the running
        firmware was signed with are installed, whatever the repository serves.

config KEYRA_BOARD_ID
    string "Board id (firmware/boards/boards.json)"
    default "devkitc1"
    help
        Picks the update asset: the default board installs keyra-firmware.bin,
        any other keyra-firmware-<id>.bin. Set by firmware/boards/<id>.defaults.

endmenu
