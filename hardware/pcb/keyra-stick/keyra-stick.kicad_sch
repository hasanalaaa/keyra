  (text "3  ESP32-S3 module"
    (exclude_from_sim no)
    (at 149.86 25.4 0)
    (effects
      (font
        (size 2 2)
        (bold yes))
      (justify left bottom))
    (uuid "5fe58658-747b-5edb-8ef5-024aa2473ae5"))
  (text "8 MB flash, no PSRAM. The antenna end is the board end: no copper under it."
    (exclude_from_sim no)
    (at 149.86 163.58 0)
    (effects
      (font
        (size 1.27 1.27))
      (justify left bottom))
    (uuid "55b1b942-ff52-5d5a-9b3a-042613595328"))
  (text "R4/C5 delay EN at power-up. IO0 keeps the chip's pull-up: JP1 to GND = download mode."
    (exclude_from_sim no)
    (at 149.86 166.88 0)
    (effects
      (font
        (size 1.27 1.27))
      (justify left bottom))
    (uuid "36fa2cb7-1c88-5429-840b-9d25cf12ee9c"))
  (text "IO19/IO20 are the chip's own USB: keyboard, security key and console."
